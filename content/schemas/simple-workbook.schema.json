{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simple-workbook.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "pageCount", "sourceType", "folder", "pagePattern", "pageRange", "identity", "a4UtilizationMaxBlankPx"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["circle", "cylinder"] },
    "label": { "type": "string", "minLength": 1 },
    "pageCount": { "type": "integer", "minimum": 1 },
    "sourceType": { "const": "numbered-html-series" },
    "folder": { "type": "string", "minLength": 1 },
    "pagePattern": { "type": "string", "pattern": "\\{page\\}" },
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nameField", "dateField"],
      "properties": {
        "nameField": { "type": "boolean" },
        "dateField": { "type": "boolean" }
      }
    },
    "a4UtilizationMaxBlankPx": { "type": "integer", "minimum": 0 }
  }
}
